const express = require('express');
const cors = require('cors');
const axios = require('axios');
const fs = require('fs');
const path = require('path');
require('dotenv').config();

const app = express();
const PORT = process.env.PORT || 3000;
const DB_FILE = path.join(__dirname, 'bookings.json');

// Middleware
app.use(cors());
app.use(express.json());

// Serve Static Files (Frontend)
app.use(express.static(__dirname));

// Initialize dummy database if not exists
if (!fs.existsSync(DB_FILE)) {
    fs.writeFileSync(DB_FILE, JSON.stringify([], null, 2));
}

// --- Helper Functions ---

// 1. Read/Write DB
function readBookings() {
    try {
        if (!fs.existsSync(DB_FILE)) return [];
        const data = fs.readFileSync(DB_FILE, 'utf8');
        return JSON.parse(data || '[]');
    } catch (err) {
        console.error('Error reading database:', err);
        return [];
    }
}

function writeBookings(data) {
    fs.writeFileSync(DB_FILE, JSON.stringify(data, null, 2));
}

// 2. LINE Messaging API (Push Message)
async function sendLineNotification(textMessage) {
    const channelAccessToken = process.env.LINE_CHANNEL_ACCESS_TOKEN;
    const userId = process.env.LINE_USER_ID;

    if (!channelAccessToken || !userId || channelAccessToken === 'YOUR_ACCESS_TOKEN') {
        console.warn('⚠️ LINE Messaging API not configured (Check .env).');
        return;
    }

    try {
        await axios.post(
            'https://api.line.me/v2/bot/message/push',
            {
                to: userId,
                messages: [{ type: 'text', text: textMessage }]
            },
            {
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${channelAccessToken}`
                }
            }
        );
        console.log('✅ LINE Push Message sent');
    } catch (error) {
        console.error('❌ Error sending LINE Message:', error.response ? error.response.data : error.message);
    }
}

// 3. Format Date for Display
function formatDate(dateStr) {
    const [y, m, d] = dateStr.split('-');
    const months = ["ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."];
    return `${parseInt(d)} ${months[parseInt(m) - 1]} ${parseInt(y) + 543}`;
}

// --- Scheduler for Daily Reminders ---
let lastRunDate = null;

function checkReminders() {
    const now = new Date();
    const todayStr = now.toISOString().split('T')[0];

    // Run only at 08:xx AM and only once per day
    if (now.getHours() === 8 && lastRunDate !== todayStr) {
        console.log('⏰ Running Daily Reminders...');
        processReminders();
        lastRunDate = todayStr;
    }
}

async function processReminders() {
    const bookings = readBookings();
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tomorrowStr = tomorrow.toISOString().split('T')[0];

    const reminders = bookings.filter(b => b.date === tomorrowStr);

    for (const booking of reminders) {
        const slotTime = booking.slot.startsWith('afternoon_')
            ? booking.slot.replace('afternoon_', '')
            : booking.slot;

        const message = `🔔 แจ้งเตือนล่วงหน้า 1 วัน
------------------
👤 เจ้าภาพ: ${booking.hostName}
📅 วันที่: ${formatDate(booking.date)}
⏰ เวลา: ${slotTime} น.
⛪ สถานที่: ${booking.location}
🙏 จำนวนพระ: ${booking.monkCount} รูป
------------------
โปรดเตรียมความพร้อมในวันพรุ่งนี้ครับ`;
        await sendLineNotification(message);
    }
}

// Check every minute
setInterval(checkReminders, 60 * 1000);
console.log('⏰ Daily Reminder Scheduler started (Runs at 08:00 AM)');

// --- API Endpoints ---

// 1. Get all bookings
app.get('/api/bookings', (req, res) => {
    const data = readBookings();
    res.json(data);
});

// 2. Create new booking
app.post('/api/bookings', async (req, res) => {
    try {
        const bookings = readBookings();
        const { date, slot, hostName, monkCount, location, type } = req.body;

        // Validation 1: Quota Check
        // 06.30 = 1 job, Others = 2 jobs
        const limit = (slot === "06.30") ? 1 : 2;
        const currentCount = bookings.filter(b => b.date === date && b.slot === slot).length;

        if (currentCount >= limit) {
            return res.status(400).json({
                success: false,
                message: `เต็มแล้ว! รอบ ${slot} รับได้สูงสุด ${limit} งาน`
            });
        }

        const newBooking = {
            id: Date.now().toString(),
            date,
            slot,
            hostName,
            monkCount,
            location,
            type: type || 'online',
            createdAt: new Date().toISOString()
        };

        bookings.push(newBooking);
        writeBookings(bookings);

        // Notification Message
        const slotTime = slot.startsWith('afternoon_') ? slot.replace('afternoon_', '') : slot;
        const notifyMsg = `🔔 มีงานนิมนต์ใหม่! (${newBooking.type === 'online' ? 'ออนไลน์' : 'เจ้าหน้าที่'})
------------------
👤 เจ้าภาพ: ${hostName}
📅 วันที่: ${formatDate(date)}
⏰ เวลา: ${slotTime} น.
⛪ สถานที่: ${location}
🙏 จำนวนพระ: ${monkCount} รูป
------------------
ตรวจสอบได้ที่: ระบบหลังบ้านวัดโพธิ์แจ้`;
        await sendLineNotification(notifyMsg);

        res.status(201).json({ success: true, booking: newBooking });
    } catch (error) {
        console.error(error);
        res.status(500).json({ success: false, message: error.message });
    }
});

// 3. Delete booking
app.delete('/api/bookings/:id', async (req, res) => {
    try {
        const { id } = req.params;
        const reason = req.query.reason || 'ไม่ระบุเหตุผล';

        const bookings = readBookings();
        const bookingIndex = bookings.findIndex(b => b.id === id);

        if (bookingIndex === -1) {
            return res.status(404).json({ success: false, message: 'Booking not found' });
        }

        const deletedBooking = bookings[bookingIndex];

        // Remove from array
        bookings.splice(bookingIndex, 1);
        writeBookings(bookings);

        // Notification Message
        const slotTime = deletedBooking.slot.startsWith('afternoon_')
            ? deletedBooking.slot.replace('afternoon_', '')
            : deletedBooking.slot;

        const notifyMsg = `❌ แจ้งเตือน: ยกเลิกงานนิมนต์
------------------
📝 เหตุผล: ${reason}
------------------
👤 เจ้าภาพ: ${deletedBooking.hostName}
📅 วันที่: ${formatDate(deletedBooking.date)}
⏰ เวลา: ${slotTime} น.
⛪ สถานที่: ${deletedBooking.location}
------------------
ระบบได้ทำการลบข้อมูลออกจากปฏิทินแล้ว`;
        await sendLineNotification(notifyMsg);

        res.json({ success: true });
    } catch (error) {
        console.error(error);
        res.status(500).json({ success: false, message: error.message });
    }
});

// Fallback for SPA (if we had client-side routing, but here we just serve index.html)
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, 'index.html'));
});

app.listen(PORT, () => {
    console.log(`🚀 Server is running on http://localhost:${PORT}`);
    console.log(`📂 Serving static files from: ${__dirname}`);
    console.log(`📝 Database file: ${DB_FILE}`);
});
